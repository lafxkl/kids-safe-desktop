<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 平台：Android + Windows（主力）+ iOS（内容版）
		     iOS 单独说明：
		       · macOS 上默认参与构建（有 Xcode 才能产出 .app/.ipa）；
		       · Windows 上默认**不**参与，避免影响现有的 Android/Windows 打包；
		         需要交叉编译/仅做编译检查时显式传 -p:EnableIosTarget=true。
		     iOS 是「内容版」：绘本、儿歌、小游戏、口算、关爱中心、家长 PIN 全保留；
		     应用白名单、桌面替换、使用统计、锁机这些依赖系统级权限的能力在 iOS 上
		     系统不开放（也不允许），由 Stub 服务静默降级，界面自动隐藏入口。 -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) or '$(EnableIosTarget)' == 'true'">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>KidsSafeDesktop</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

	<!-- Display name（安装后桌面图标显示的名称） -->
	<ApplicationTitle>儿童安全桌面</ApplicationTitle>

		<!-- ══ 发行渠道 ══════════════════════════════════════════════════════
		     国内版与海外版打两个独立的包，差异不止「哪个商店上架」：
		       cn     国内版：**不含** Singular Kids SDK（AAR 与代码都不编译进来）
		       global 海外版：含 Singular Kids SDK，包名换成自己的域名
		     命令：dotnet build -c Release -f net10.0-android -p:AppChannel=global
		     不传默认 cn（与历史包名一致，老用户可平滑升级）。 -->
		<AppChannel Condition="'$(AppChannel)' == ''">cn</AppChannel>

		<!-- 海外渠道把中间产物挪到了 obj\global\（见 Directory.Build.props），
		     而 SDK 默认的 DefaultItemExcludes 只排除当前 BaseIntermediateOutputPath，
		     旧的 obj\ 就不在被排除范围里了，`**/*.cs` 会把上一轮的生成文件也扫进来
		     （表现为 CS0111：__TypeRegistrations 重复定义）。这里把两个目录都排掉。 -->
		<DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**;obj\global\**;bin\global\**</DefaultItemExcludes>

		<!-- App Identifier
		     国内版沿用 com.companyname.kidssafedesktop：v1.x 已经用这个包名发了 20 多个版本，
		     换掉等于变成另一个应用，老用户升级会丢数据。
		     海外版是全新上架，用域名反写的正式包名。 -->
		<ApplicationId Condition="'$(AppChannel)' != 'global'">com.companyname.kidssafedesktop</ApplicationId>
		<ApplicationId Condition="'$(AppChannel)' == 'global'">cc.siguangblog.kidsafe</ApplicationId>

		<!-- iOS 的 Bundle ID 全渠道统一用 cc.siguangblog.kidsafe：
		     Bundle ID 一经上架就不能改，草稿期也不该再折腾。
		     Android 那个 com.companyname.* 是历史包名（老用户升级不能换），iOS 没这个包袱。
		     下面这一行写在最后，用于覆盖上面两行的渠道取值。 -->
		<ApplicationId Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">cc.siguangblog.kidsafe</ApplicationId>

		<!-- iOS 签名：从 Signing.iOS.props 读（不入库，格式见 Signing.iOS.props.sample）。
		     没有这个文件时走 Xcode 自动签名（本地模拟器调试不需要签名）。
		     团队 ID 不用单独给 —— 已经包含在 CodesignKey 的括号里。 -->
		<CodesignKey Condition="'$(CodesignKey)' == ''">$(IosCodesignKey)</CodesignKey>
		<CodesignProvision Condition="'$(CodesignProvision)' == ''">$(IosCodesignProvision)</CodesignProvision>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.20</ApplicationDisplayVersion>
		<ApplicationVersion>21</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- 多语言资源：只保留简繁中文和英文。
		     不加这一行，Windows 发布目录会带 120 多个语言子目录（af-ZA、am-ET、ar-SA……
		     每个是一套 WinUI/.NET 的本地化资源库），全部原样打进安装包却永远不会被读到。
		     Android 侧同样生效，APK 里的 res/values-xx 也随之收敛。 -->
		<SatelliteResourceLanguages>zh-Hans;zh-Hant;en</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#B388FF" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#B388FF" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Scripts/BookRender/winrt-render 是一个独立的小工具工程（把 PDF 渲成页图），
		     有自己的入口点，不能被 App 一起编译，否则会和多平台入口冲突。 -->
		<Compile Remove="Scripts\**\*.cs" />
		<None Include="Scripts\BookRender\**\*" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.Contains('-android'))">
		<!-- 荣耀推送 SDK（Push Kit）。AAR 直接放在 Platforms/Android/libs 并随仓库提交：
		     荣耀的 Maven 库（https://developer.honor.com/repo）不在 Maven Central 上，
		     .NET 的 AndroidMavenLibrary 取不到，离线构建也不该依赖它。
		     Singular 两个 AAR 单独挑出来：只有海外版才带（见下面的条件引入），
		     国内包里连类都不存在，dex 里一个字节都没有。 -->
		<AndroidLibrary Include="Platforms\Android\libs\*.aar"
		                Exclude="Platforms\Android\libs\singular_kids_sdk*.aar;Platforms\Android\libs\installreferrer*.aar" />
		<AndroidLibrary Include="Platforms\Android\libs\singular_kids_sdk*.aar;Platforms\Android\libs\installreferrer*.aar"
		                Condition="'$(AppChannel)' == 'global'" />

		<!-- 调用荣耀 SDK 的 Java 桥：SDK 没有 C# 绑定，用 .java 编译进 APK，
		     C# 侧通过 JNI 调（见 Platforms/Android/HonorPush.cs）。 -->
		<AndroidJavaSource Include="Platforms\Android\Java\**\*.java" />

		<!-- 开发者控制台下载的配置文件，按荣耀文档放进 assets 根目录 -->
		<AndroidAsset Include="Platforms\Android\Assets\mcs-services.json" Link="mcs-services.json" />

		<!-- AAR 的绑定转换：修 Singular Kids SDK 的命名冲突（详见该文件里的注释）。
		     @(TransformFile) 由 Bindings.Core.targets 统一消费，放在 App 工程里同样有效。
		     只在国内版之外引入——国内版没有 Singular 的绑定，转换文件里的类型不存在，
		     留着会让绑定生成器报「找不到 com.singular.sdk.internal.Utils」。 -->
		<TransformFile Include="Platforms\Android\Transforms\Metadata.xml"
		               Condition="'$(AppChannel)' == 'global'" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<!-- 仅 Debug 构建需要：AddDebug() 已在 #if DEBUG 内，Release 不再引用，故限定为 Debug 条件引用以免发布包带入调试日志库 -->
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" Condition="'$(Configuration)' == 'Debug'" />
	</ItemGroup>

	<!-- 界面与逻辑（Pages / ViewModels / Services / Models / Helpers / Controls / Converters）
	     已整体迁入 KidsSafeShared，孩子端与家长端共用同一份实现。
	     本工程只保留 App 外壳：App.xaml、MauiProgram、Platforms、Resources、打包配置。
	     共享库里的 SQLite 等依赖会通过本引用传递过来，这里不再重复声明。 -->
	<ItemGroup>
		<ProjectReference Include="..\KidsSafeShared\KidsSafeShared.csproj" />
	</ItemGroup>

	<!-- ══ 海外版归因：Singular Kids SDK（只有海外包带）═══════════════════════
	     两个包：-p:AppChannel=cn（默认）不带这个 SDK；-p:AppChannel=global 带。
	     海外包内部还有一次运行时地区判定：中国大陆设备连 init 都不调用
	     （判断代码见 Platforms/Android/SingularAnalytics.cs），属于「编译期不带 +
	     运行期不加载」双保险。
	     密钥两种给法，优先前者（不入库）：
	       1) 复制 Singular.props.sample 为 Singular.props 填 Key / Secret；
	       2) 或构建时传 -p:SingularApiKey=... -p:SingularSecret=...
	     没配密钥时整个功能自动降级为空操作，不崩、不联网。 -->
	<Import Project="Singular.props" Condition="Exists('Singular.props')" />

	<PropertyGroup>
		<!-- 环境变量兜底：CI 上直接 export SINGULAR_API_KEY 即可 -->
		<SingularApiKey Condition="'$(SingularApiKey)' == ''">$(SINGULAR_API_KEY)</SingularApiKey>
		<SingularSecret Condition="'$(SingularSecret)' == ''">$(SINGULAR_SECRET)</SingularSecret>
		<!-- 国内版固定 cn（且代码根本不编译，这行只是兜底）；
		     海外版默认 auto，仍保留运行时地区判定：装了海外包的中国大陆设备也不上报。 -->
		<SingularChannel Condition="'$(SingularChannel)' == '' and '$(AppChannel)' == 'global'">auto</SingularChannel>
		<SingularChannel Condition="'$(SingularChannel)' == ''">cn</SingularChannel>
	</PropertyGroup>

	<!-- 海外版才编译 Singular 相关代码（SingularAnalytics.cs / MainActivity 里的接线）。
	     国内版没有 AAR → 没有 Com.Singular.Sdk 命名空间，不定义宏就是「代码都不存在」。 -->
	<PropertyGroup Condition="'$(AppChannel)' == 'global'">
		<DefineConstants>$(DefineConstants);SINGULAR</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<!-- 渠道与密钥编进程序集元数据，运行时用 AssemblyMetadataAttribute 读。
		     密钥为空就不生成条目，代码读到空串按「未配置」处理。 -->
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>AppChannel</_Parameter1>
			<_Parameter2>$(AppChannel)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(SingularApiKey)' != ''">
			<_Parameter1>SingularApiKey</_Parameter1>
			<_Parameter2>$(SingularApiKey)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(SingularSecret)' != ''">
			<_Parameter1>SingularSecret</_Parameter1>
			<_Parameter2>$(SingularSecret)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>SingularChannel</_Parameter1>
			<_Parameter2>$(SingularChannel)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<!-- 安卓签名（keystore 口令）：单独文件，Debug/Release 统一使用同一签名证书，
	     否则荣耀推送会因签名指纹不一致报 10202。 -->
	<Import Project="Signing.props" Condition="Exists('Signing.props')" />

	<!-- ══ iOS 工程项 ═════════════════════════════════════════════════════════
	     ① 隐私清单：App Store 从 2024-05 起强制要求，缺了直接拒审。
	        内容与 Info.plist 的说明文案必须一致（谁在读、为什么读、读了什么）。
	     ② 权限声明文件：没有推送/内购/App Groups 时是空字典，但保留文件，
	        将来加推送只改这里，不用再动工程。
	     ③ 启动方向：iPad 允许四向，iPhone 只竖屏 —— 桌面向来是竖屏交互，
	        横屏会让所有 Nine-Patch 背景与网格列数错位。 -->
	<Import Project="Signing.iOS.props" Condition="Exists('Signing.iOS.props')" />

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<BundleResource Include="Platforms\iOS\Resources\PrivacyInfo.xcprivacy"
		                Condition="Exists('Platforms\iOS\Resources\PrivacyInfo.xcprivacy')" />
	</ItemGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<!-- 当前没有推送 / 内购 / App Groups，无需 entitlements。
		     Platforms\iOS\Entitlements.plist 只是留档模板，等真要加能力时
		     把下面这行的注释去掉即可（空字典直接签名反而会覆盖签名流程注入的默认项）。 -->
		<!-- <CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements> -->
	</PropertyGroup>

	<!-- ══ 去掉上一轮残留的 AAR 产物（只在国内版）═════════════════════════════
	     国内版不引用 Singular 与 installreferrer 两个 AAR，但 obj 里可能还留着
	     上一轮解包/编译的产物。这些残留不会报错，会**静默**把类打进 dex——
	     包里带着统计 SDK 的类，清单里却没有对应权限，最难发现。
	     要清的四处：
	       generated/src/Com.Singular.*.cs、Com.Android.InstallReferrer.*.cs  → 绑定源码
	       android/src/com/{singular,android/installreferrer}/**              → 解包的 Java
	       android/src/mono/com/android/installreferrer/**                    → 绑定的 Java 实现类
	       android/bin/classes/com/{singular,android/installreferrer}         → 已编译的 class
	       library_project_jars/{singular_kids_sdk,installreferrer}*.aar      → 待 dex 的 jar
	     分渠道目录（见 Directory.Build.props）已经能避免以后互污染，
	     这里属于兜底：老 obj 目录、或者手动混用参数时也不会漏进去。 -->
	<Target Name="KsDropStaleSingularBindings" BeforeTargets="CoreCompile"
	        Condition="'$(TargetFramework.Contains(&quot;-android&quot;))' == 'true' and '$(AppChannel)' != 'global'">
		<ItemGroup>
			<_StaleBinding Include="$(IntermediateOutputPath)generated\src\Com.Singular.*.cs" />
			<_StaleBinding Include="$(IntermediateOutputPath)generated\src\Com.Android.InstallReferrer.*.cs" />
			<_StaleJava Include="$(IntermediateOutputPath)android\src\com\singular\**\*.java" />
			<_StaleJava Include="$(IntermediateOutputPath)android\src\com\android\installreferrer\**\*.java" />
			<_StaleJava Include="$(IntermediateOutputPath)android\src\mono\com\android\installreferrer\**\*.java" />
			<_StaleJar Include="$(IntermediateOutputPath)library_project_jars\singular_kids_sdk*.aar" />
			<_StaleJar Include="$(IntermediateOutputPath)library_project_jars\installreferrer*.aar" />
			<Compile Remove="@(_StaleBinding)" />
		</ItemGroup>
		<Delete Files="@(_StaleBinding);@(_StaleJava);@(_StaleJar)" />
		<RemoveDir Directories="$(IntermediateOutputPath)android\bin\classes\com\singular;$(IntermediateOutputPath)android\bin\classes\com\android\installreferrer" />
	</Target>

	<!-- ══ Windows 发布包瘦身 ══════════════════════════════════════════════════
	     自包含发布会把整套 .NET 运行时和 Windows App SDK 原样复制出去，
	     其中有一部分本应用永远用不到。这里是「按文件名精确剔除」的白名单，
	     不涉及裁剪器（PublishTrimmed），不会因反射/序列化被裁坏。

	     剔除分三类，每类都注明理由；加新条目请先确认全项目无引用。 -->
	<Target Name="TrimWindowsPublish" AfterTargets="ComputeFilesToPublish"
	        Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ItemGroup>
			<!-- ① 调试诊断类：只在「进程崩溃后解析 dump / 读取 pdb」时才被加载。
			     createdump.exe 是运行时生成转储文件的工具，本应用没有崩溃上报，不打包 pdb，
			     安装脚本也已排除 *.pdb，这几个文件没有使用场景。 -->
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
				Condition="'%(Filename)' == 'createdump'
				        Or '%(Filename)' == 'mscordaccore'
				        Or '%(Filename)' == 'mscordbi'
				        Or '%(Filename)' == 'Microsoft.DiaSymReader.Native.amd64'
				        Or $([System.String]::Copy('%(Filename)').StartsWith('mscordaccore_amd64'))" />

			<!-- ② 框架里确定没用到的程序集：
			     VisualBasic 运行时（本工程全 C#）、CSharp 动态绑定（代码里无 dynamic 关键字）、
			     AsyncEnumerable/Dataflow/Tar/ServerSentEvents/CodePages/AccessControl
			     —— 全局搜索均无引用，且没有 Encoding.RegisterProvider 调用。 -->
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
				Condition="'%(Filename)' == 'Microsoft.VisualBasic'
				        Or '%(Filename)' == 'Microsoft.VisualBasic.Core'
				        Or '%(Filename)' == 'Microsoft.CSharp'
				        Or '%(Filename)' == 'System.Linq.AsyncEnumerable'
				        Or '%(Filename)' == 'System.Threading.Tasks.Dataflow'
				        Or '%(Filename)' == 'System.Text.Encoding.CodePages'
				        Or '%(Filename)' == 'System.Formats.Tar'
				        Or '%(Filename)' == 'System.Net.ServerSentEvents'
				        Or '%(Filename)' == 'System.Threading.AccessControl'
				        Or '%(Filename)' == 'System.ServiceModel.Web'" />

			<!-- ③ WinUI 原生控件的本地化资源（.mui 文件）：
			     SatelliteResourceLanguages 只管得到托管卫星程序集，管不到 Microsoft.UI.Xaml
			     这一批 .mui。它们分布在 70 多个语言子目录里，每个 44K。
			     只留简繁中文和英文，其余剔除；缺失时 WinUI 会自动回退到英文。 -->
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
				Condition="'%(Extension)' == '.mui'
				        And !$([System.String]::Copy('%(RelativeDir)').Contains('zh-Hans'))
				        And !$([System.String]::Copy('%(RelativeDir)').Contains('zh-Hant'))
				        And !$([System.String]::Copy('%(RelativeDir)').Contains('zh-CN'))
				        And !$([System.String]::Copy('%(RelativeDir)').Contains('zh-TW'))
			        And !$([System.String]::Copy('%(RelativeDir)').Contains('en-us'))
			        And !$([System.String]::Copy('%(RelativeDir)').Contains('en-GB'))" />

			<!-- ④ MSIX 打包专用图标（仅 WindowsPackageType=None 时剔除）：
			     SmallTile / MediumTile / LargeTile / WideTile / StoreLogo / Logo 这几组
			     只被 Package.appxmanifest 引用 —— 开始菜单磁贴、应用商店列表用。
			     本项目是免打包分发（WindowsPackageType=None，走 Inno Setup 安装），
			     根本没有 appxmanifest，这些图永远不会被加载；共 40 个文件约 2MB，
			     LargeTile 的 scale-400 单张就有 624K。
			     保留 appicon.ico（窗口与任务栏图标）和 splashSplashScreen*（启动图）。
			     将来若改成 MSIX 打包，把 WindowsPackageType 一改，本段自动失效。

			     注意必须用 StartsWith：这些文件名形如 appiconLargeTile.scale-400.png，
			     %(Filename) 是「appiconLargeTile.scale-400」，用 == 精确比较匹配不到。 -->
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
				Condition="'$(WindowsPackageType)' == 'None'
				        And ($([System.String]::Copy('%(Filename)').StartsWith('appiconSmallTile'))
				          Or $([System.String]::Copy('%(Filename)').StartsWith('appiconMediumTile'))
				          Or $([System.String]::Copy('%(Filename)').StartsWith('appiconLargeTile'))
				          Or $([System.String]::Copy('%(Filename)').StartsWith('appiconWideTile'))
				          Or $([System.String]::Copy('%(Filename)').StartsWith('appiconStoreLogo'))
				          Or $([System.String]::Copy('%(Filename)').StartsWith('appiconLogo')))" />
		</ItemGroup>
	</Target>

</Project>
