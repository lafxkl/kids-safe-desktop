<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KidsSafeDesktop.ViewModels"
             x:Class="KidsSafeDesktop.Pages.PinyinLiteracyPage"
             Title="拼音识字"
             Background="{StaticResource KidPageGradient}">

    <Grid RowDefinitions="Auto,*">
        <!-- 顶部栏 -->
        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,12" Background="{StaticResource KidHeaderGradient}">
            <Button Text="← 返回" TextColor="White" BackgroundColor="Transparent" BorderWidth="0"
                    FontSize="16" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Grid.Column="1" Text="🔤 拼音识字" TextColor="White" FontSize="20" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="2" Text="{Binding ScoreText}" TextColor="White" FontSize="18"
                   HorizontalOptions="End" VerticalOptions="Center" />
        </Grid>

        <!-- 游戏区 -->
        <ScrollView Grid.Row="1" IsVisible="{Binding NotFinished}" Padding="24,16">
            <VerticalStackLayout Spacing="22" VerticalOptions="Center">
                <Label Text="{Binding ProgressText}" FontSize="18" TextColor="#00838F"
                       HorizontalOptions="Center" />
                <Label Text="{Binding DifficultyLabel, StringFormat='难度：{0}'}" FontSize="15"
                       TextColor="#26C6DA" HorizontalOptions="Center" />

                <Frame BackgroundColor="#FFFFFF" CornerRadius="24" HeightRequest="200" WidthRequest="200"
                       HorizontalOptions="Center" HasShadow="False" Padding="14">
                    <Grid>
                        <Image Source="{Binding CurrentImage}"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               Aspect="AspectFit" HeightRequest="170" WidthRequest="170">
                            <Image.Triggers>
                                <DataTrigger TargetType="Image" Binding="{Binding ShowImage}" Value="False">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Image.Triggers>
                        </Image>
                        <Label Text="{Binding CurrentEmoji}" FontSize="120"
                               HorizontalOptions="Center" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ShowImage}" Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                </Frame>

                <Label Text="{Binding QuestionWord}" FontSize="56" FontAttributes="Bold"
                       TextColor="#006064" HorizontalOptions="Center" />

                <Label Text="它的拼音是什么呀？" FontSize="26" FontAttributes="Bold" TextColor="#00838F"
                       HorizontalOptions="Center" />

                <Button Text="🔊 听一听这个字" FontSize="18" BackgroundColor="#FFB300" TextColor="White"
                        CornerRadius="20" HeightRequest="46" WidthRequest="200"
                        HorizontalOptions="Center" Clicked="OnSpeak" />

                <Frame CornerRadius="16" Padding="12" HasShadow="False"
                       IsVisible="{Binding HasFeedback}" BackgroundColor="#E8F5E9">
                    <Frame.Style>
                        <Style TargetType="Frame">
                            <Style.Triggers>
                                <DataTrigger TargetType="Frame" Binding="{Binding IsCorrect}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#C8E6C9" />
                                </DataTrigger>
                                <DataTrigger TargetType="Frame" Binding="{Binding IsWrong}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#FFCDD2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Frame.Style>
                    <Label Text="{Binding FeedbackText}" FontSize="24" FontAttributes="Bold"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Style.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsCorrect}" Value="True">
                                        <Setter Property="TextColor" Value="#2E7D32" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsWrong}" Value="True">
                                        <Setter Property="TextColor" Value="#C62828" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>
                </Frame>

                <FlexLayout Direction="Column" BindableLayout.ItemsSource="{Binding Options}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChoiceOption">
                            <Button Text="{Binding Display}" FontSize="{Binding FontSize}" FontAttributes="Bold"
                                    BackgroundColor="#FFFFFF" TextColor="#37474F" CornerRadius="18"
                                    HeightRequest="64" WidthRequest="300" HorizontalOptions="Center"
                                    Margin="0,7"
                                    Clicked="OnOptionClicked" CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 完成区 -->
        <ScrollView Grid.Row="1" IsVisible="{Binding Finished}" Padding="40,30">
            <VerticalStackLayout Spacing="24" VerticalOptions="Center">
                <Label Text="🏆" FontSize="100" HorizontalOptions="Center" />
                <Label Text="你真棒！" FontSize="38" FontAttributes="Bold" TextColor="#006064"
                       HorizontalOptions="Center" />
                <Label Text="{Binding ResultText}" FontSize="22" TextColor="#00838F"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Button Text="🔄 再玩一次" FontSize="22" BackgroundColor="#26C6DA" TextColor="White"
                        CornerRadius="18" HeightRequest="60" WidthRequest="240" HorizontalOptions="Center"
                        Clicked="OnReplay" />
                <Button Text="🏠 回主页" FontSize="20" BackgroundColor="#FFFFFF" TextColor="#00ACC1"
                        CornerRadius="18" HeightRequest="56" WidthRequest="240" HorizontalOptions="Center"
                        Clicked="OnBack" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
