<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KidsSafeDesktop.ViewModels"
             x:Class="KidsSafeDesktop.Pages.ListenGamePage"
             Title="听音选物"
             Background="{StaticResource KidPageGradient}">

    <Grid RowDefinitions="Auto,*">
        <!-- 顶部栏 -->
        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,12" Background="{StaticResource KidHeaderGradient}">
            <Button Text="← 返回" TextColor="White" BackgroundColor="Transparent" BorderWidth="0"
                    FontSize="16" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Grid.Column="1" Text="🔊 听音选物" TextColor="White" FontSize="20" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="2" Text="{Binding ProgressText}" TextColor="White" FontSize="16"
                   HorizontalOptions="End" VerticalOptions="Center" />
        </Grid>

        <!-- 游戏区 -->
        <ScrollView Grid.Row="1" IsVisible="{Binding NotFinished}" Padding="24,16">
            <VerticalStackLayout Spacing="22" VerticalOptions="Center">
                <Label Text="仔细听，是哪个呀？" FontSize="26" FontAttributes="Bold"
                       TextColor="#880E4F" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Label Text="{Binding DifficultyLabel, StringFormat='难度：{0}'}" FontSize="15"
                       TextColor="#D81B60" HorizontalOptions="Center" />

                <Button Text="🔊 再听一次" FontSize="22" BackgroundColor="#EC407A" TextColor="White"
                        CornerRadius="18" HeightRequest="58" WidthRequest="240" HorizontalOptions="Center"
                        Clicked="OnSpeak" />

                <Frame CornerRadius="16" Padding="12" HasShadow="False"
                       IsVisible="{Binding HasFeedback}" BackgroundColor="#E8F5E9">
                    <Frame.Style>
                        <Style TargetType="Frame">
                            <Style.Triggers>
                                <DataTrigger TargetType="Frame" Binding="{Binding IsCorrect}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#C8E6C9" />
                                </DataTrigger>
                                <DataTrigger TargetType="Frame" Binding="{Binding IsWrong}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#FFCDD2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Frame.Style>
                    <Label Text="{Binding FeedbackText}" FontSize="24" FontAttributes="Bold"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Style.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsCorrect}" Value="True">
                                        <Setter Property="TextColor" Value="#2E7D32" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsWrong}" Value="True">
                                        <Setter Property="TextColor" Value="#C62828" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>
                </Frame>

                <CollectionView ItemsSource="{Binding Options}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="3"
                                        HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ListenOption">
                            <Border StrokeShape="RoundRectangle 20" StrokeThickness="0"
                                    BackgroundColor="#FFFFFF" HeightRequest="110" HorizontalOptions="Fill">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOptionTapped" NumberOfTapsRequired="1" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Emoji}" FontSize="56"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 完成区 -->
        <ScrollView Grid.Row="1" IsVisible="{Binding Finished}" Padding="40,30">
            <VerticalStackLayout Spacing="24" VerticalOptions="Center">
                <Label Text="🏆" FontSize="100" HorizontalOptions="Center" />
                <Label Text="你真棒！" FontSize="38" FontAttributes="Bold" TextColor="#880E4F"
                       HorizontalOptions="Center" />
                <Label Text="{Binding ResultText}" FontSize="22" TextColor="#D81B60"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Button Text="🔄 再玩一次" FontSize="22" BackgroundColor="#D81B60" TextColor="White"
                        CornerRadius="18" HeightRequest="60" WidthRequest="240" HorizontalOptions="Center"
                        Clicked="OnReplay" />
                <Button Text="🏠 回主页" FontSize="20" BackgroundColor="#FFFFFF" TextColor="#D81B60"
                        CornerRadius="18" HeightRequest="56" WidthRequest="240" HorizontalOptions="Center"
                        Clicked="OnBack" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
