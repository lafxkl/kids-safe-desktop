<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KidsSafeDesktop.ViewModels"
             xmlns:models="clr-namespace:KidsSafeDesktop.Models"
             x:Class="KidsSafeDesktop.Pages.EnglishStudyPage"
             Title="英语学习"
             Background="{StaticResource KidPageGradient}">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- 顶部栏 -->
        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,12" Background="#7E57C2">
            <Button Text="← 返回" TextColor="White" BackgroundColor="Transparent" BorderWidth="0"
                    FontSize="16" HorizontalOptions="Start" Clicked="OnBack" />
            <Label x:Name="TitleLabel" Grid.Column="1" Text="英语学习" TextColor="White" FontSize="20" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <Button Grid.Column="2" x:Name="BtnSpeakTop" Text="🔊" FontSize="22" BackgroundColor="Transparent"
                    BorderWidth="0" TextColor="White" Clicked="OnSpeakCurrent" />
        </Grid>

        <!-- 模式切换 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" Padding="20,10">
            <Button x:Name="BtnLearn" Text="📖 学习" FontSize="18" FontAttributes="Bold"
                    CornerRadius="20" HeightRequest="48" Clicked="OnModeLearn" />
            <Button x:Name="BtnQuiz" Grid.Column="1" Text="📝 练习" FontSize="18" FontAttributes="Bold"
                    CornerRadius="20" HeightRequest="48" Clicked="OnModeQuiz" />
        </Grid>

        <!-- ===== 学习模式 ===== -->
        <ScrollView Grid.Row="2" Padding="20,8,20,40" IsVisible="{Binding IsLearn}">
            <VerticalStackLayout Spacing="14">
                <!-- 分类 -->
                <Label Text="分类" FontSize="14" TextColor="#5E35B1" FontAttributes="Bold" />
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="CategoryStack" Spacing="8" />
                </ScrollView>

                <!-- 单词卡 -->
                <Frame BackgroundColor="#FFFFFF" CornerRadius="26" Padding="20,28" HasShadow="False"
                       BorderColor="#D1C4E9" IsVisible="{Binding LearnWord, Converter={StaticResource HasItem}}">
                    <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                        <Label Text="{Binding LearnWord.Emoji}" FontSize="72"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding LearnWord.Word}" FontSize="46" FontAttributes="Bold"
                               TextColor="#311B92" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding LearnWord.Phonetic}" FontSize="18" TextColor="#7E57C2"
                               HorizontalOptions="Center" IsVisible="{Binding LearnWord.Phonetic, Converter={StaticResource HasItem}}" />
                        <Label Text="{Binding LearnWord.Meaning}" FontSize="28" FontAttributes="Bold"
                               TextColor="#E65100" HorizontalOptions="Center"
                               IsVisible="{Binding ShowMeaning}" />
                        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Button Text="👀 看意思" FontSize="18" BackgroundColor="#FFE0B2" TextColor="#E65100"
                                    CornerRadius="18" HeightRequest="46" Clicked="OnToggleMeaning" />
                            <Button Text="🔊 听发音" FontSize="18" BackgroundColor="#7E57C2" TextColor="White"
                                    CornerRadius="18" HeightRequest="46" Clicked="OnSpeakCurrent" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- 翻页 -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                    <Button Text="⬅️ 上一个" FontSize="18" BackgroundColor="#B39DDB" TextColor="White"
                            CornerRadius="20" HeightRequest="50" Clicked="OnLearnPrev"
                            IsEnabled="{Binding LearnHasPrev}" />
                    <Button Grid.Column="1" Text="下一个 ➡️" FontSize="18" BackgroundColor="#7E57C2" TextColor="White"
                            CornerRadius="20" HeightRequest="50" Clicked="OnLearnNext"
                            IsEnabled="{Binding LearnHasNext}" />
                </Grid>
                <Label Text="{Binding LearnProgress}" FontSize="16" TextColor="#5E35B1"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== 练习模式（未结束）===== -->
        <ScrollView Grid.Row="2" Padding="20,8,20,40" IsVisible="{Binding IsQuiz}">
            <VerticalStackLayout Spacing="14" IsVisible="{Binding QuizNotFinished}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding QuizProgress}" FontSize="16" TextColor="#4527A0" VerticalOptions="Center" />
                    <Frame Grid.Column="1" BackgroundColor="#FFF3E0" CornerRadius="16" Padding="12,6"
                           HasShadow="False" BorderColor="Transparent">
                        <Label Text="{Binding QuizScoreText}" FontSize="16" FontAttributes="Bold" TextColor="#E65100" />
                    </Frame>
                </Grid>

                <Frame BackgroundColor="#FFFFFF" CornerRadius="26" Padding="20,26" HasShadow="False"
                       BorderColor="#D1C4E9" IsVisible="{Binding CurrentQuestion, Converter={StaticResource HasItem}}">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Label Text="{Binding CurrentQuestion.Word.Emoji}" FontSize="64" HorizontalOptions="Center" />
                        <Label Text="{Binding CurrentQuestion.Word.Word}" FontSize="44" FontAttributes="Bold"
                               TextColor="#311B92" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding CurrentQuestion.Word.Phonetic}" FontSize="16" TextColor="#7E57C2"
                               HorizontalOptions="Center"
                               IsVisible="{Binding CurrentQuestion.Word.Phonetic, Converter={StaticResource HasItem}}" />
                        <Button Text="🔊 听一听" FontSize="16" BackgroundColor="#E1F5FE" TextColor="#0277BD"
                                CornerRadius="16" HeightRequest="40" Clicked="OnQuizSpeak" />
                    </VerticalStackLayout>
                </Frame>

                <!-- 选项 -->
                <VerticalStackLayout Spacing="10">
                    <Button x:Name="BtnOpt0" FontSize="22" FontAttributes="Bold" CornerRadius="18"
                            HeightRequest="56" Clicked="OnOption0" />
                    <Button x:Name="BtnOpt1" FontSize="22" FontAttributes="Bold" CornerRadius="18"
                            HeightRequest="56" Clicked="OnOption1" />
                    <Button x:Name="BtnOpt2" FontSize="22" FontAttributes="Bold" CornerRadius="18"
                            HeightRequest="56" Clicked="OnOption2" />
                    <Button x:Name="BtnOpt3" FontSize="22" FontAttributes="Bold" CornerRadius="18"
                            HeightRequest="56" Clicked="OnOption3" />
                </VerticalStackLayout>

                <Label Text="{Binding QuizFeedback}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"
                       IsVisible="{Binding HasQuizFeedback}"
                       TextColor="{Binding QuizCorrect, Converter={StaticResource BoolToColor}, ConverterParameter='#2E7D32,#E53935'}" />

                <Button Text="➡️ 下一题" FontSize="22" BackgroundColor="#7E57C2" TextColor="White"
                        CornerRadius="22" HeightRequest="58" Clicked="OnQuizNext" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== 成绩报告（练习结束）===== -->
        <ScrollView Grid.Row="2" Padding="20,8,20,40" IsVisible="{Binding QuizFinished}">
            <VerticalStackLayout Spacing="16">
                <Frame BackgroundColor="#FFFFFF" CornerRadius="26" Padding="24,28" HasShadow="False"
                       BorderColor="#D1C4E9">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Label Text="{Binding QuizResultText}" FontSize="26" FontAttributes="Bold"
                               TextColor="#4527A0" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding QuizTotalText}" FontSize="20" TextColor="#5D4037" HorizontalOptions="Center" />
                        <Label Text="{Binding QuizAccuracyText}" FontSize="22" FontAttributes="Bold"
                               TextColor="#2E7D32" HorizontalOptions="Center" />
                        <Label Text="{Binding QuizScoreText}" FontSize="20" TextColor="#E65100" HorizontalOptions="Center" />
                        <Label Text="{Binding QuizTimeText}" FontSize="18" TextColor="#0288D1" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="#FFF3E0" CornerRadius="22" Padding="16,14" HasShadow="False"
                       BorderColor="Transparent" IsVisible="{Binding QuizWrongRecords.Count, Converter={StaticResource HasPrecip}}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="📋 错题回顾" FontSize="20" FontAttributes="Bold" TextColor="#E65100" />
                        <CollectionView ItemsSource="{Binding QuizWrongRecords}">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:WrongRecord">
                                    <Frame BackgroundColor="#FFFFFF" CornerRadius="14" Padding="12,8"
                                           HasShadow="False" BorderColor="#FFCCBC">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Expression}" FontSize="18" FontAttributes="Bold" TextColor="#5D4037" />
                                            <Label Text="{Binding CorrectText, StringFormat='正确答案：{0}'}" FontSize="14" TextColor="#2E7D32" />
                                            <Label Text="{Binding YourText, StringFormat='你的答案：{0}'}" FontSize="14" TextColor="#E53935" />
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                    <Button Text="🔄 再来一组" FontSize="20" BackgroundColor="#43A047" TextColor="White"
                            CornerRadius="22" HeightRequest="56" Clicked="OnQuizReplay" />
                    <Button Text="🏠 返回首页" FontSize="20" BackgroundColor="#9575CD" TextColor="White"
                            CornerRadius="22" HeightRequest="56" Clicked="OnBack" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
