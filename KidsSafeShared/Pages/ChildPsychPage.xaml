<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KidsSafeDesktop.Pages.ChildPsychPage"
             Title="儿童心理学"
             BackgroundColor="#F4FAF8">

    <Grid RowDefinitions="Auto,*">

        <!-- 顶部栏：标题旁固定挂「公益项目」标识，即便网页没加载出来也看得见 -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="12,10" BackgroundColor="#2E9E8F">
            <Button Grid.Column="0" Text="← 返回" TextColor="White" BackgroundColor="Transparent"
                    BorderWidth="0" FontSize="15" HorizontalOptions="Start" Clicked="OnBack" />

            <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="儿童心理学" TextColor="White" FontSize="19" FontAttributes="Bold"
                       VerticalOptions="Center" />
                <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="7,2"
                        StrokeShape="RoundRectangle 9" VerticalOptions="Center">
                    <Label Text="公益项目" TextColor="#1F7A6E" FontSize="10.5" FontAttributes="Bold"
                           CharacterSpacing="1" />
                </Border>
            </HorizontalStackLayout>

            <Button Grid.Column="2" Text="↑" TextColor="White" BackgroundColor="Transparent"
                    BorderWidth="0" FontSize="21" FontAttributes="Bold" Clicked="OnTop" />
            <Button Grid.Column="3" Text="刷新" TextColor="White" BackgroundColor="Transparent"
                    BorderWidth="0" FontSize="14" Clicked="OnReload" />
        </Grid>

        <!-- 正文（网页，离线内置） -->
        <WebView x:Name="DocView" Grid.Row="1" BackgroundColor="#F4FAF8" />

        <!-- 打不开时的说明：公益内容，绝不让家长对着白屏猜 -->
        <Grid x:Name="ErrorPanel" Grid.Row="1" IsVisible="False" Padding="32,0">
            <VerticalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Center"
                                 MaximumWidthRequest="460">
                <Label Text="？" FontSize="38" FontAttributes="Bold" TextColor="#2E9E8F" HorizontalOptions="Center" />
                <Label Text="这个页面没能打开" FontSize="19" FontAttributes="Bold" TextColor="#1F7A6E"
                       HorizontalOptions="Center" />
                <Label x:Name="ErrorDetail" Text="内容就在安装包里，不需要联网。"
                       FontSize="14" TextColor="#3E5461" HorizontalTextAlignment="Center"
                       LineHeight="1.5" HorizontalOptions="Center" />
                <Button Text="再试一次" FontSize="16" TextColor="White" BackgroundColor="#2E9E8F"
                        CornerRadius="22" Padding="26,0" HeightRequest="44"
                        HorizontalOptions="Center" Clicked="OnRetry" />
            </VerticalStackLayout>
        </Grid>

        <!-- 释放资源 / 等待网页就绪 -->
        <Grid x:Name="LoadingMask" Grid.Row="0" Grid.RowSpan="2"
              BackgroundColor="#CCF4FAF8" IsVisible="False">
            <VerticalStackLayout Spacing="14" VerticalOptions="Center" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="True" Color="#2E9E8F" WidthRequest="46" HeightRequest="46" />
                <Label Text="正在打开…" FontSize="17" TextColor="#1F7A6E"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
