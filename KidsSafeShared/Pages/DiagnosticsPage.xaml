<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KidsSafeDesktop.Pages.DiagnosticsPage"
             Title="诊断日志"
             BackgroundColor="#F5F7FA">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">

        <!-- ===== 顶部：日志位置 + 推送状态 ===== -->
        <Border Grid.Row="0" BackgroundColor="White" StrokeThickness="0"
                StrokeShape="RoundRectangle 16" Padding="14">
            <VerticalStackLayout Spacing="8">
                <Label Text="📁 日志文件位置" FontSize="15" FontAttributes="Bold" TextColor="#263238" />
                <Label x:Name="PathLabel" FontSize="12" TextColor="#546E7A" LineBreakMode="CharacterWrap" />
                <Label x:Name="PathHintLabel" FontSize="12" TextColor="#EF6C00" LineBreakMode="WordWrap" />

                <BoxView HeightRequest="1" Color="#ECEFF1" Margin="0,4" />

                <Label Text="📡 推送状态（安卓）" FontSize="15" FontAttributes="Bold" TextColor="#263238" />
                <Label x:Name="PushLabel" FontSize="13" TextColor="#546E7A" LineBreakMode="WordWrap" />

                <BoxView HeightRequest="1" Color="#ECEFF1" Margin="0,4" />

                <Label Text="🔑 包名与签名指纹（荣耀平台需一致）" FontSize="15" FontAttributes="Bold" TextColor="#263238" />
                <Label x:Name="SignLabel" FontSize="12" TextColor="#546E7A" LineBreakMode="CharacterWrap" />

                <BoxView HeightRequest="1" Color="#ECEFF1" Margin="0,4" />

                <Label Text="🔄 实时下发通道（长轮询，不依赖厂商推送）" FontSize="15" FontAttributes="Bold" TextColor="#263238" />
                <Label x:Name="LiveLabel" FontSize="12" TextColor="#546E7A" LineBreakMode="CharacterWrap" />
            </VerticalStackLayout>
        </Border>

        <!-- ===== 中间：日志正文 ===== -->
        <Border Grid.Row="1" BackgroundColor="#263238" StrokeThickness="0"
                StrokeShape="RoundRectangle 16" Padding="12">
            <ScrollView>
                <Label x:Name="LogLabel" Text="正在读取…" FontSize="11"
                       FontFamily="Consolas" TextColor="#B2FF59"
                       LineBreakMode="CharacterWrap" />
            </ScrollView>
        </Border>

        <!-- ===== 底部：操作 ===== -->
        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <Label x:Name="StatusLabel" FontSize="13" TextColor="#2E7D32" HorizontalOptions="Center" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="🔄 刷新" FontSize="16" BackgroundColor="#ECEFF1"
                        TextColor="#37474F" CornerRadius="12" HeightRequest="50" Clicked="OnRefresh" />
                <Button Grid.Column="1" Text="📋 复制全部" FontSize="16" BackgroundColor="#00897B"
                        TextColor="White" CornerRadius="12" HeightRequest="50" Clicked="OnCopy" />
            </Grid>
            <Button x:Name="RetryPushButton" Text="🔁 重新申请推送 token" FontSize="15"
                    BackgroundColor="#1565C0" TextColor="White" CornerRadius="12" HeightRequest="46"
                    Clicked="OnRetryPush" />
            <Label Text="改完荣耀控制台的证书指纹后点这个，不用重启应用（30 秒内只能点一次）"
                   FontSize="11" TextColor="#90A4AE" HorizontalTextAlignment="Center" />
            <Button Text="返回" FontSize="15" BackgroundColor="Transparent" TextColor="#607D8B"
                    CornerRadius="12" HeightRequest="42" Clicked="OnBack" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
