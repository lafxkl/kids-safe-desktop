<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KidsSafeDesktop.Pages.StoryPlayerPage"
             Title="听故事"
             Padding="0">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0.7,0" EndPoint="0.3,1">
                <GradientStop Color="#232A63" Offset="0" />
                <GradientStop Color="#141A3F" Offset="0.45" />
                <GradientStop Color="#0A0E2A" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- 顶部 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="14,12">
            <Button Grid.Column="0" Text="←" FontSize="18" WidthRequest="40" HeightRequest="40"
                    CornerRadius="20" BackgroundColor="#1C244E" TextColor="#EEF1FF" Clicked="OnBack" />
            <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="Center">
                <Label x:Name="TitleLabel" Text="故事标题" FontSize="17" FontAttributes="Bold"
                       TextColor="#FFE9A8" HorizontalOptions="Center" LineBreakMode="TailTruncation" />
                <Label x:Name="TagLabel" Text="" FontSize="11" TextColor="#8AB4FF" HorizontalOptions="Center" />
            </VerticalStackLayout>
            <Button Grid.Column="2" x:Name="FavBtn" Text="☆" FontSize="17" WidthRequest="40"
                    HeightRequest="40" CornerRadius="20" BackgroundColor="#1C244E" TextColor="#FFE9A8"
                    Clicked="OnToggleFav" />
        </Grid>

        <!-- 正文 -->
        <ScrollView Grid.Row="1" x:Name="TextScroll" Padding="20,6,20,10">
            <VerticalStackLayout x:Name="ParaHost" Spacing="10" />
        </ScrollView>

        <!-- 控制区 -->
        <Frame Grid.Row="2" Margin="12,0,12,14" Padding="14,12" CornerRadius="22" HasShadow="False"
               BackgroundColor="#141A3F" BorderColor="#2A3568">
            <VerticalStackLayout Spacing="10">

                <Grid ColumnDefinitions="*,Auto">
                    <Label x:Name="ProgressLabel" Text="准备朗读" FontSize="12.5" TextColor="#AAB2D8"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1" x:Name="TimerLabel" Text="" FontSize="12.5" FontAttributes="Bold"
                           TextColor="#FFD98A" VerticalOptions="Center" />
                </Grid>

                <Grid HeightRequest="6">
                    <BoxView CornerRadius="3" Color="#232B55" />
                    <BoxView x:Name="ProgressFill" CornerRadius="3" Color="#8AB4FF"
                             HorizontalOptions="Start" WidthRequest="0" />
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" x:Name="PlayBtn" Text="▶ 播放" FontSize="15" FontAttributes="Bold"
                            HeightRequest="48" CornerRadius="16" BackgroundColor="#8AB4FF" TextColor="#0A0E2A"
                            Clicked="OnPlay" />
                    <Button Grid.Column="1" x:Name="PauseBtn" Text="⏸ 暂停" FontSize="15" HeightRequest="48"
                            CornerRadius="16" BackgroundColor="#1C244E" TextColor="#EEF1FF"
                            IsEnabled="False" Clicked="OnPause" />
                    <Button Grid.Column="2" Text="⏹ 停止" FontSize="15" HeightRequest="48" CornerRadius="16"
                            BackgroundColor="#1C244E" TextColor="#FFB3D1" Clicked="OnStop" />
                </Grid>

                <!-- 朗读节奏 -->
                <Label Text="朗读节奏" FontSize="11.5" TextColor="#7C86B8" />
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="SpeedBar" Spacing="8" />
                </ScrollView>

                <!-- 声音风格 -->
                <Label Text="🗣 声音风格" FontSize="11.5" TextColor="#7C86B8" />
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="VoiceBar" Spacing="8" />
                </ScrollView>
                <Label x:Name="VoiceHint" Text="" FontSize="11" TextColor="#8C95C4" />

                <!-- 睡眠定时 -->
                <Label Text="⏰ 听完就睡（定时关闭）" FontSize="11.5" TextColor="#7C86B8" />
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="TimerBar" Spacing="8" />
                </ScrollView>

                <!-- 做成图片卡 -->
                <Button Text="📤 把故事做成图片卡" FontSize="13" HeightRequest="40" CornerRadius="14"
                        BackgroundColor="#1C244E" TextColor="#FFE9A8" Clicked="OnShareCard" />
            </VerticalStackLayout>
        </Frame>

        <!-- 晚安遮罩 -->
        <Grid Grid.RowSpan="3" x:Name="GoodNightLayer" IsVisible="False" BackgroundColor="#E60A0E1F">
            <VerticalStackLayout Spacing="14" VerticalOptions="Center" HorizontalOptions="Center"
                                 Padding="30">
                <Label Text="🌙" FontSize="60" HorizontalOptions="Center" />
                <Label Text="晚安，好梦" FontSize="26" FontAttributes="Bold" TextColor="#FFE9A8"
                       HorizontalOptions="Center" />
                <Label x:Name="GoodNightSub" Text="故事讲完了，该睡觉啦～" FontSize="14"
                       TextColor="#AAB2D8" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Button Text="知道了" FontSize="15" HeightRequest="46" WidthRequest="160" CornerRadius="16"
                        BackgroundColor="#1C244E" TextColor="#EEF1FF" Clicked="OnCloseGoodNight"
                        Margin="0,10,0,0" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
