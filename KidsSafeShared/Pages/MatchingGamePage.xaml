<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KidsSafeDesktop.ViewModels"
             x:Class="KidsSafeDesktop.Pages.MatchingGamePage"
             Title="拼图配对"
             Background="{StaticResource KidPageGradient}">

    <Grid RowDefinitions="Auto,*">
        <!-- 顶部栏 -->
        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,12" Background="{StaticResource KidHeaderGradient}">
            <Button Text="← 返回" TextColor="White" BackgroundColor="Transparent" BorderWidth="0"
                    FontSize="16" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Grid.Column="1" Text="🧩 拼图配对" TextColor="White" FontSize="20" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="2" Text="{Binding ProgressText}" TextColor="White" FontSize="16"
                   HorizontalOptions="End" VerticalOptions="Center" />
        </Grid>

        <!-- 游戏区 -->
        <ScrollView Grid.Row="1" IsVisible="{Binding NotFinished}" Padding="20,16">
            <VerticalStackLayout Spacing="12">
                <Label Text="{Binding DifficultyLabel, StringFormat='难度：{0}'}" FontSize="15"
                       TextColor="#EF6C00" HorizontalOptions="Center" />
                <CollectionView ItemsSource="{Binding Cards}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3"
                                    HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MemoryCard">
                        <Border StrokeShape="RoundRectangle 18" StrokeThickness="0"
                                HeightRequest="100" HorizontalOptions="Fill" BackgroundColor="#FFE0B2">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardTapped" NumberOfTapsRequired="1" />
                            </Border.GestureRecognizers>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding FaceUp}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#FFFFFF" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Matched}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#C8E6C9" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Label Text="{Binding Display}" FontSize="46"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 完成区 -->
        <ScrollView Grid.Row="1" IsVisible="{Binding Finished}" Padding="40,30">
            <VerticalStackLayout Spacing="24" VerticalOptions="Center">
                <Label Text="🏆" FontSize="100" HorizontalOptions="Center" />
                <Label Text="你真棒！" FontSize="38" FontAttributes="Bold" TextColor="#E65100"
                       HorizontalOptions="Center" />
                <Label Text="{Binding ResultText}" FontSize="22" TextColor="#EF6C00"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Button Text="🔄 再玩一次" FontSize="22" BackgroundColor="#EF6C00" TextColor="White"
                        CornerRadius="18" HeightRequest="60" WidthRequest="240" HorizontalOptions="Center"
                        Clicked="OnReplay" />
                <Button Text="🏠 回主页" FontSize="20" BackgroundColor="#FFFFFF" TextColor="#EF6C00"
                        CornerRadius="18" HeightRequest="56" WidthRequest="240" HorizontalOptions="Center"
                        Clicked="OnBack" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
