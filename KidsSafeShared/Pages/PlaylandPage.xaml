<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KidsSafeDesktop.Pages.PlaylandPage"
             Title="游戏乐园"
             BackgroundColor="#1A237E">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 顶部栏：与「小游戏乐园」大厅同一套紫色系，返回 / 游戏名 / 刷新。
             不再放「主页」按钮——从大厅点进来时 WebView 没有后退历史，
             「← 返回」本身就会回到大厅，多一个按钮反而让人犹豫。 -->
        <Grid ColumnDefinitions="Auto,*,Auto" Padding="12,10" BackgroundColor="#5E35B1">
            <Button Grid.Column="0" Text="← 返回" TextColor="White" BackgroundColor="Transparent"
                    BorderWidth="0" FontSize="15" HorizontalOptions="Start" Clicked="OnBack" />
            <Label x:Name="TitleLabel" Grid.Column="1" Text="🎮 小游戏" TextColor="White" FontSize="19"
                   FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                   LineBreakMode="TailTruncation" MaxLines="1" />
            <Button Grid.Column="2" Text="🔄" TextColor="White" BackgroundColor="Transparent"
                    BorderWidth="0" FontSize="18" Clicked="OnReload" />
        </Grid>

        <!-- 网页游戏容器 -->
        <WebView x:Name="GameView" Grid.Row="1" />

        <!-- 底部提示 -->
        <Label Grid.Row="2" Text="💡 网页小游戏共 15 款，已内置，无需联网"
               FontSize="12" TextColor="#C5CAE9" HorizontalOptions="Center" Margin="0,6,0,8" />

        <!-- 释放资源时的加载提示 -->
        <Grid x:Name="LoadingMask" Grid.Row="0" Grid.RowSpan="3"
              BackgroundColor="#CC1A237E" IsVisible="False">
            <VerticalStackLayout Spacing="14" VerticalOptions="Center" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="True" Color="#FFFFFF" WidthRequest="48" HeightRequest="48" />
                <Label Text="🎮 正在准备游戏…" FontSize="18" TextColor="White"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
