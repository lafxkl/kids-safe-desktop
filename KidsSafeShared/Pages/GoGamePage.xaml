<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KidsSafeDesktop.Pages.GoGamePage"
             Title="围棋小课堂"
             Background="{StaticResource KidPageGradient}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- 顶部栏 -->
        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,12" Background="{StaticResource KidHeaderGradient}">
            <Button Text="← 返回" TextColor="White" BackgroundColor="Transparent" BorderWidth="0"
                    FontSize="16" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Grid.Column="1" Text="⚫ 围棋小课堂" TextColor="White" FontSize="20" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="2" x:Name="MoveLabel" Text="第 0 手" TextColor="White" FontSize="15"
                   HorizontalOptions="End" VerticalOptions="Center" />
        </Grid>

        <!-- 状态条：轮到谁 + 双方提子数 -->
        <Frame Grid.Row="1" Margin="14,8,14,0" Padding="14,9" CornerRadius="16" HasShadow="False"
               BackgroundColor="#FFFFFF" BorderColor="Transparent">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label x:Name="StatusLabel" Text="轮到你啦，你执黑先行" FontSize="15.5" FontAttributes="Bold"
                       TextColor="#4E342E" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                <Label Grid.Column="1" x:Name="CaptureLabel" Text="提子 0 : 0" FontSize="14"
                       TextColor="#8D6E63" VerticalOptions="Center" />
            </Grid>
        </Frame>

        <!-- 棋盘：按可用空间等比反算，方形居中 -->
        <Grid Grid.Row="2" x:Name="BoardHost" Padding="10,8" SizeChanged="OnBoardHostSizeChanged">
            <GraphicsView x:Name="Board" StartInteraction="OnBoardTap" />
        </Grid>

        <!-- 底部操作 -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="10" Padding="14,4,14,18">
            <Button x:Name="UndoBtn" Grid.Column="0" Text="↩️ 悔棋" FontSize="17" FontAttributes="Bold"
                    BackgroundColor="#FFFFFF" TextColor="#6D4C41" CornerRadius="16" HeightRequest="50"
                    Clicked="OnUndo" />
            <Button Grid.Column="1" Text="🔄 重开" FontSize="17" FontAttributes="Bold"
                    BackgroundColor="#8D6E63" TextColor="White" CornerRadius="16" HeightRequest="50"
                    Clicked="OnRestart" />
            <Button Grid.Column="2" Text="🏁 数子" FontSize="17" FontAttributes="Bold"
                    BackgroundColor="#5D4037" TextColor="White" CornerRadius="16" HeightRequest="50"
                    Clicked="OnCountScore" />
        </Grid>

        <!-- 结算浮层 -->
        <Grid Grid.RowSpan="4" x:Name="ResultLayer" IsVisible="False" BackgroundColor="#00000066">
            <Frame Margin="28" Padding="26" CornerRadius="24" HasShadow="False" BackgroundColor="#FFFFFF"
                   BorderColor="Transparent" HorizontalOptions="Fill" VerticalOptions="Center">
                <!-- 不用 ScrollView：结算内容高度固定（约 350px），套滚动容器后反而会测量成 0 高度 -->
                <VerticalStackLayout Spacing="16">
                    <Label Text="🏁" FontSize="64" HorizontalOptions="Center" />
                    <Label x:Name="ResultTitle" Text="对局结束" FontSize="28" FontAttributes="Bold"
                           TextColor="#3E2723" HorizontalOptions="Center" />
                    <Label x:Name="ResultScore" Text="" FontSize="19" TextColor="#6D4C41"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <BoxView HeightRequest="1" Color="#EEE5DD" Margin="0,4" />
                    <Label x:Name="ResultTip" Text="" FontSize="14.5" TextColor="#8D6E63"
                           HorizontalTextAlignment="Center" />
                    <Button Text="🔄 再来一局" FontSize="19" FontAttributes="Bold"
                            BackgroundColor="#5D4037" TextColor="White" CornerRadius="16"
                            HeightRequest="52" Clicked="OnRestart" Margin="0,6,0,0" />
                    <Button Text="🏠 回小游戏" FontSize="17" BackgroundColor="#EFEBE9" TextColor="#5D4037"
                            CornerRadius="16" HeightRequest="48" Clicked="OnBack" />
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
