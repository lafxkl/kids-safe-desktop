<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KidsSafeDesktop.Pages.StoryReaderPage"
             Title="故事"
             Padding="0">

    <Grid RowDefinitions="Auto,*">

        <!-- 顶部栏 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="10,12"
              BackgroundColor="#6A1B9A">
            <Button Text="← 返回" TextColor="White" BackgroundColor="Transparent" BorderWidth="0"
                    FontSize="16" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Grid.Column="1" Text="📖 故事" TextColor="White" FontSize="18" FontAttributes="Bold"
                   VerticalOptions="Center" HorizontalOptions="Center" />
            <Button Grid.Column="2" x:Name="ReadButton" Text="🔊 读给小朋友" FontSize="13" TextColor="White"
                    BackgroundColor="#4A148C" CornerRadius="14" HeightRequest="38" Clicked="OnReadToggle" />
        </Grid>

        <!-- 正文 -->
        <ScrollView Grid.Row="1" Padding="20,16">
            <VerticalStackLayout Spacing="14">
                <Frame WidthRequest="110" HeightRequest="110" CornerRadius="55" Padding="0"
                       HasShadow="False" HorizontalOptions="Center" x:Name="HeaderFrame"
                       BackgroundColor="#8E24AA">
                    <Label x:Name="PosterLabel" Text="📖" FontSize="58"
                           HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" />
                </Frame>
                <Label x:Name="TitleLabel" Text="" FontSize="24" FontAttributes="Bold"
                       TextColor="#4A148C" HorizontalOptions="Center" HorizontalTextAlignment="Center" />

                <HorizontalStackLayout x:Name="MetaLayout" Spacing="10" HorizontalOptions="Center">
                    <Frame Padding="10,4" CornerRadius="14" HasShadow="False" BackgroundColor="#F3E5F5">
                        <Label x:Name="TypeLabel" Text="" FontSize="13" TextColor="#8E24AA" />
                    </Frame>
                    <Frame Padding="10,4" CornerRadius="14" HasShadow="False" BackgroundColor="#F3E5F5">
                        <Label x:Name="TimeLabel" Text="" FontSize="13" TextColor="#9575CD" />
                    </Frame>
                </HorizontalStackLayout>

                <BoxView HeightRequest="1" BackgroundColor="#E1BEE7" Margin="0,6" />

                <StackLayout x:Name="BodyList" Spacing="12" />
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator x:Name="Busy" Grid.Row="1" IsRunning="False" IsVisible="False"
                           Color="#AB47BC" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
