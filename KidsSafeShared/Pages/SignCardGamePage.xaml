<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KidsSafeDesktop.Pages.SignCardGamePage"
             Title="手语图卡"
             Background="{StaticResource KidPageGradient}">

    <Grid RowDefinitions="Auto,*">

        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,12" Background="{StaticResource KidHeaderGradient}">
            <Button Text="← 返回" TextColor="White" BackgroundColor="Transparent" BorderWidth="0"
                    FontSize="16" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Grid.Column="1" Text="🤟 手语图卡" TextColor="White" FontSize="19"
                   FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
            <Button Grid.Column="2" x:Name="ModeButton" Text="练一练" TextColor="White"
                    BackgroundColor="Transparent" BorderWidth="0" FontSize="14"
                    HorizontalOptions="End" Clicked="OnToggleMode" />
        </Grid>

        <!-- ================= 学一学 ================= -->
        <Grid x:Name="LearnView" Grid.Row="1" RowDefinitions="*,Auto" Padding="18,12,18,20">

            <Border StrokeShape="RoundRectangle 28" StrokeThickness="0" BackgroundColor="#FFFFFF"
                    Padding="20,18">
                <ScrollView>
                    <VerticalStackLayout Spacing="9">
                        <Label x:Name="CardEmoji" Text="🤟" FontSize="60" HorizontalOptions="Center" />
                        <Label x:Name="CardWord" Text="" FontSize="34" FontAttributes="Bold"
                               TextColor="#263238" HorizontalOptions="Center" />
                        <Label x:Name="CardPinyin" Text="" FontSize="16" TextColor="#78909C"
                               HorizontalOptions="Center" />

                        <BoxView HeightRequest="1" Color="#ECEFF1" Margin="0,6" />

                        <Label Text="🤲 手形怎么做" FontSize="13" FontAttributes="Bold"
                               TextColor="#00897B" />
                        <Label x:Name="CardHand" Text="" FontSize="16" TextColor="#37474F"
                               LineBreakMode="WordWrap" />

                        <Label Text="👄 口型怎么摆" FontSize="13" FontAttributes="Bold"
                               TextColor="#E65100" Margin="0,6,0,0" />
                        <Label x:Name="CardMouth" Text="" FontSize="16" TextColor="#37474F"
                               LineBreakMode="WordWrap" />

                        <Label Text="手势为简化示意，规范打法请以《国家通用手语》或特教老师示范为准。"
                               FontSize="11" TextColor="#90A4AE" Margin="0,8,0,0"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,14,0,0">
                <Button Grid.Column="0" Text="◀" FontSize="20" BackgroundColor="#FFFFFF"
                        TextColor="#00897B" CornerRadius="18" WidthRequest="64" HeightRequest="56"
                        Clicked="OnPrevCard" />
                <Button Grid.Column="1" x:Name="StartQuizButton" Text="开始练一练 ▶"
                        FontSize="17" FontAttributes="Bold" BackgroundColor="#00897B"
                        TextColor="White" CornerRadius="18" HeightRequest="56" Clicked="OnStartQuiz" />
                <Button Grid.Column="2" Text="▶" FontSize="20" BackgroundColor="#FFFFFF"
                        TextColor="#00897B" CornerRadius="18" WidthRequest="64" HeightRequest="56"
                        Clicked="OnNextCard" />
            </Grid>
        </Grid>

        <!-- ================= 练一练 ================= -->
        <Grid x:Name="QuizView" Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" Padding="18,10,18,20"
              IsVisible="False">

            <Label Grid.Row="0" x:Name="QuizProgress" Text="第 1 / 8 题" FontSize="14"
                   TextColor="#00897B" HorizontalOptions="Center" FontAttributes="Bold" />

            <Border Grid.Row="1" StrokeShape="RoundRectangle 24" StrokeThickness="0"
                    BackgroundColor="#FFFFFF" Padding="16,14" Margin="0,8,0,0">
                <VerticalStackLayout Spacing="6">
                    <Label Text="这个手势是什么意思？" FontSize="15" FontAttributes="Bold"
                           TextColor="#263238" HorizontalOptions="Center" />
                    <Label x:Name="QuizEmoji" Text="" FontSize="44" HorizontalOptions="Center" />
                    <Label x:Name="QuizHand" Text="" FontSize="15" TextColor="#37474F"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Grid.Row="2" x:Name="OptionsHost" Spacing="10" Margin="0,14,0,0"
                                 VerticalOptions="Start" />

            <Label Grid.Row="3" x:Name="QuizFeedback" Text="" FontSize="16" FontAttributes="Bold"
                   TextColor="#00897B" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
        </Grid>

        <!-- 结果层 -->
        <Grid Grid.Row="0" Grid.RowSpan="2" x:Name="ResultLayer" IsVisible="False"
              BackgroundColor="#F5FFFFFF">
            <ScrollView Padding="28,20">
                <VerticalStackLayout Spacing="16" VerticalOptions="Center">
                    <Label Text="🏆" FontSize="76" HorizontalOptions="Center" />
                    <Label x:Name="ResultTitle" Text="练习完成！" FontSize="26" FontAttributes="Bold"
                           TextColor="#00695C" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <Label x:Name="ResultDetail" Text="" FontSize="17" TextColor="#00796B"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    <Label Text="把手势带到生活里：吃饭前做「吃饭」，出门时做「再见」，比只看卡片记得牢。"
                           FontSize="14" TextColor="#6D4C41" HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    <Button Text="🔄 再练一次" FontSize="19" BackgroundColor="#00897B" TextColor="White"
                            CornerRadius="18" HeightRequest="58" Margin="0,8,0,0" Clicked="OnRestartQuiz" />
                    <Button Text="📖 回去看卡片" FontSize="17" BackgroundColor="#FFFFFF" TextColor="#00897B"
                            CornerRadius="18" HeightRequest="54" Clicked="OnToggleMode" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
