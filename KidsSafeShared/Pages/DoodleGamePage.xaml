<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KidsSafeDesktop.ViewModels"
             x:Class="KidsSafeDesktop.Pages.DoodleGamePage"
             Title="快乐涂鸦"
             Background="{StaticResource KidPageGradient}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 顶部栏 -->
        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,12" Background="{StaticResource KidHeaderGradient}">
            <Button Text="← 返回" TextColor="White" BackgroundColor="Transparent" BorderWidth="0"
                    FontSize="16" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Grid.Column="1" Text="🎨 快乐涂鸦" TextColor="White" FontSize="20" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="💾 保存" TextColor="White" BackgroundColor="Transparent" BorderWidth="0"
                    FontSize="16" HorizontalOptions="End" Clicked="OnSave" />
        </Grid>

        <!-- 画布 -->
        <Frame Grid.Row="1" BackgroundColor="White" CornerRadius="18" Padding="0" Margin="16,8"
               HasShadow="False" BorderColor="#E1BEE7">
            <GraphicsView x:Name="Canvas" BackgroundColor="White"
                         StartInteraction="OnDrawStart" DragInteraction="OnDrawDrag" EndInteraction="OnDrawEnd" />
        </Frame>

        <!-- 工具栏 -->
        <VerticalStackLayout Grid.Row="2" Padding="12,6,12,18" Spacing="10">
            <!-- 调色板 -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Colors}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DoodleColorItem">
                            <Frame WidthRequest="42" HeightRequest="42" CornerRadius="21" Padding="0"
                                   HasShadow="False" BorderColor="#CE93D8">
                                <Frame.BackgroundColor>
                                    <Binding Path="Hex" />
                                </Frame.BackgroundColor>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnColorTapped" NumberOfTapsRequired="1" />
                                </Frame.GestureRecognizers>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- 笔刷 / 橡皮 / 撤销 / 清空 -->
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                <Frame WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0" HasShadow="False"
                       BackgroundColor="{Binding SelectedColor}" BorderColor="#AB47BC">
                    <Label Text="✏️" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Frame>

                <Button x:Name="BtnEraser" Text="🩹 橡皮" FontSize="15" BackgroundColor="#FFFFFF"
                        TextColor="#AB47BC" CornerRadius="16" HeightRequest="44" WidthRequest="92"
                        Clicked="OnEraser" />

                <Button x:Name="BtnBrushS" Text="细" FontSize="15" BackgroundColor="#AB47BC" TextColor="White"
                        CornerRadius="16" HeightRequest="44" WidthRequest="54" Clicked="OnBrushS" />
                <Button x:Name="BtnBrushM" Text="中" FontSize="15" BackgroundColor="#FFFFFF" TextColor="#AB47BC"
                        CornerRadius="16" HeightRequest="44" WidthRequest="54" Clicked="OnBrushM" />
                <Button x:Name="BtnBrushL" Text="粗" FontSize="15" BackgroundColor="#FFFFFF" TextColor="#AB47BC"
                        CornerRadius="16" HeightRequest="44" WidthRequest="54" Clicked="OnBrushL" />
                <Button x:Name="BtnBrushXL" Text="特粗" FontSize="14" BackgroundColor="#FFFFFF" TextColor="#AB47BC"
                        CornerRadius="16" HeightRequest="44" WidthRequest="60" Clicked="OnBrushXL" />

                <Button Text="↩️" FontSize="18" BackgroundColor="#FFFFFF" TextColor="#AB47BC"
                        CornerRadius="16" HeightRequest="44" WidthRequest="48" Clicked="OnUndo" />
                <Button Text="🗑️" FontSize="18" BackgroundColor="#FFFFFF" TextColor="#AB47BC"
                        CornerRadius="16" HeightRequest="44" WidthRequest="48" Clicked="OnClear" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
