<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KidsSafeDesktop.Pages.DiaryPage"
             Title="我的日记"
             Padding="0">

    <Grid RowDefinitions="Auto,*">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
                <GradientStop Color="#F7F3FF" Offset="0" />
                <GradientStop Color="#F2F7FF" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- 顶部条 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="16,12" BackgroundColor="#7E57C2">
            <Button Grid.Column="0" Text="← 返回" FontSize="15" TextColor="White" BackgroundColor="Transparent"
                    BorderWidth="0" Clicked="OnBack" />
            <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="Center">
                <Label Text="🔐 我的日记" FontSize="19" FontAttributes="Bold" TextColor="White"
                       HorizontalOptions="Center" />
                <Label x:Name="HeaderSub" Text="只有你的密码能打开" FontSize="10.5" TextColor="#E1D5F5"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
            <Button Grid.Column="2" x:Name="LockButton" Text="🔒" FontSize="16" TextColor="White"
                    BackgroundColor="Transparent" BorderWidth="0" IsVisible="False" Clicked="OnLockNow" />
        </Grid>

        <Grid Grid.Row="1">

            <!-- ① 锁屏 / 设置密码 -->
            <ScrollView x:Name="LockPanel" Padding="26,6,26,26">
                <VerticalStackLayout Spacing="0" VerticalOptions="Center" Margin="0,14,0,0">
                    <Label x:Name="LockEmoji" Text="📔" FontSize="54" HorizontalOptions="Center" />
                    <Label x:Name="LockTitle" Text="给自己设一个密码" FontSize="22" FontAttributes="Bold"
                           TextColor="#4A3B6B" HorizontalOptions="Center" Margin="0,10,0,0" />
                    <Label x:Name="LockSub" Text="4 位数字，只有你知道" FontSize="13" TextColor="#8E7FA8"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,6,0,0" />

                    <Label x:Name="DotsLabel" Text="○ ○ ○ ○" FontSize="23" TextColor="#7E57C2"
                           HorizontalOptions="Center" Margin="0,24,0,0" />

                    <Label x:Name="LockMsg" Text="" FontSize="12.5" TextColor="#E57373" IsVisible="False"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,10,0,0" />

                    <Grid x:Name="Keypad" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="12" RowSpacing="12" Margin="0,18,0,0" />

                    <Button x:Name="ForgotButton" Text="忘记密码了？" FontSize="12.5" TextColor="#7E57C2"
                            BackgroundColor="Transparent" BorderWidth="0" HeightRequest="34"
                            Clicked="OnForgot" Margin="0,12,0,0" />

                    <Label x:Name="LockFoot" Text="" FontSize="11" TextColor="#9C8FB5"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,8,0,0"
                           LineHeight="1.4" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- ② 日记列表 -->
            <Grid x:Name="ListPanel" IsVisible="False" RowDefinitions="Auto,Auto,*"
                  Padding="16,12,16,0" RowSpacing="10">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Frame Grid.Column="0" Padding="12,0" CornerRadius="16" HasShadow="False"
                           BackgroundColor="White" BorderColor="#E6DCF8" HeightRequest="42">
                        <Entry x:Name="SearchEntry" Placeholder="搜一搜写过什么" FontSize="13.5"
                               TextColor="#4A3B6B" PlaceholderColor="#B3A6C9" BackgroundColor="Transparent"
                               TextChanged="OnSearchChanged" VerticalOptions="Center" />
                    </Frame>
                    <Button Grid.Column="1" Text="✍️ 写一篇" FontSize="13.5" HeightRequest="42" Padding="15,0"
                            CornerRadius="21" BackgroundColor="#7E57C2" TextColor="White" Clicked="OnNewEntry" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Frame Grid.Column="0" Padding="8,10" CornerRadius="16" HasShadow="False"
                           BackgroundColor="White" BorderColor="#EDE4FB">
                        <VerticalStackLayout Spacing="1">
                            <Label x:Name="CountLabel" Text="0" FontSize="19" FontAttributes="Bold"
                                   TextColor="#7E57C2" HorizontalOptions="Center" />
                            <Label Text="篇日记" FontSize="10.5" TextColor="#9C8FB5" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="1" Padding="8,10" CornerRadius="16" HasShadow="False"
                           BackgroundColor="White" BorderColor="#EDE4FB">
                        <VerticalStackLayout Spacing="1">
                            <Label x:Name="MonthLabel" Text="0" FontSize="19" FontAttributes="Bold"
                                   TextColor="#FB8C00" HorizontalOptions="Center" />
                            <Label Text="这个月" FontSize="10.5" TextColor="#9C8FB5" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Padding="8,10" CornerRadius="16" HasShadow="False"
                           BackgroundColor="White" BorderColor="#EDE4FB">
                        <VerticalStackLayout Spacing="1">
                            <Label x:Name="StreakLabel" Text="0" FontSize="19" FontAttributes="Bold"
                                   TextColor="#E53935" HorizontalOptions="Center" />
                            <Label Text="连续天数" FontSize="10.5" TextColor="#9C8FB5" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <ScrollView Grid.Row="2">
                    <VerticalStackLayout Spacing="10" Padding="0,2,0,28">

                        <Frame x:Name="PromptCard" Padding="14,12" CornerRadius="18" HasShadow="False"
                               BackgroundColor="#FFF8E1" BorderColor="#FFE082">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="💡 不知道写什么？" FontSize="12.5" FontAttributes="Bold"
                                       TextColor="#8A6D00" />
                                <Label x:Name="PromptLabel" Text="" FontSize="14" TextColor="#6B5A2A"
                                       LineHeight="1.5" />
                                <Button Text="换一句" FontSize="11.5" HeightRequest="28" Padding="10,0"
                                        BackgroundColor="Transparent" TextColor="#8A6D00"
                                        HorizontalOptions="Start" Clicked="OnNextPrompt" />
                            </VerticalStackLayout>
                        </Frame>

                        <VerticalStackLayout x:Name="EntryHost" Spacing="9" />

                        <VerticalStackLayout x:Name="EmptyState" Spacing="8" Padding="0,18,0,0" IsVisible="False">
                            <Label Text="📖" FontSize="44" HorizontalOptions="Center" />
                            <Label Text="还没有日记" FontSize="15" FontAttributes="Bold" TextColor="#6B5C86"
                                   HorizontalOptions="Center" />
                            <Label Text="写一句话就算开始了，不用写得多好，也不用给别人看。"
                                   FontSize="12" TextColor="#9C8FB5" HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                            <Button Text="写第一篇" FontSize="13" HeightRequest="38" Padding="20,0"
                                    CornerRadius="19" BackgroundColor="#7E57C2" TextColor="White"
                                    HorizontalOptions="Center" Clicked="OnNewEntry" Margin="0,6,0,0" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <!-- ③ 写日记 -->
            <Grid x:Name="EditorPanel" IsVisible="False" RowDefinitions="Auto,*">

                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="8,8,14,8">
                    <Button Grid.Column="0" Text="← 日记本" FontSize="14" TextColor="#7E57C2"
                            BackgroundColor="Transparent" BorderWidth="0" Clicked="OnBackToList" />
                    <Label Grid.Column="1" x:Name="EditorDateLabel" Text="" FontSize="13" TextColor="#8E7FA8"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Button Grid.Column="2" Text="保存" FontSize="14" HeightRequest="36" Padding="20,0"
                            CornerRadius="18" BackgroundColor="#7E57C2" TextColor="White"
                            Clicked="OnSaveEntry" />
                </Grid>

                <ScrollView Grid.Row="1" Padding="16,2,16,24">
                    <VerticalStackLayout Spacing="12">

                        <Frame Padding="12,8" CornerRadius="18" HasShadow="False" BackgroundColor="White"
                               BorderColor="#EDE4FB">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="今天的心情（可以不选）" FontSize="11.5" TextColor="#9C8FB5" />
                                <Grid x:Name="MoodHost" ColumnDefinitions="*,*,*,*,*,*,*,*" ColumnSpacing="2" />
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Padding="12,2" CornerRadius="16" HasShadow="False" BackgroundColor="White"
                               BorderColor="#EDE4FB">
                            <Entry x:Name="TitleEntry" Placeholder="给今天起个题目（可以不写）" FontSize="15"
                                   FontAttributes="Bold" TextColor="#4A3B6B" PlaceholderColor="#B3A6C9"
                                   BackgroundColor="Transparent" MaxLength="40" />
                        </Frame>

                        <Frame Padding="12,8" CornerRadius="16" HasShadow="False" BackgroundColor="White"
                               BorderColor="#EDE4FB">
                            <Editor x:Name="BodyEditor" Placeholder="今天发生了什么？想写什么都可以。"
                                    FontSize="15" TextColor="#3E3352" PlaceholderColor="#B3A6C9"
                                    BackgroundColor="Transparent" AutoSize="TextChanges"
                                    MinimumHeightRequest="240" MaxLength="20000"
                                    TextChanged="OnBodyChanged" />
                        </Frame>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label x:Name="WordCountLabel" Text="0 字" FontSize="12" TextColor="#9C8FB5"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="🔊 读给我听" FontSize="12" HeightRequest="32"
                                    Padding="12,0" CornerRadius="16" BackgroundColor="#EDE7F6"
                                    TextColor="#5E35B1" Clicked="OnSpeakEntry" />
                        </Grid>

                        <Button x:Name="DeleteButton" Text="🗑 删掉这一篇" FontSize="12.5"
                                BackgroundColor="Transparent" TextColor="#C62828" BorderColor="#FFCDD2"
                                BorderWidth="1" CornerRadius="18" HeightRequest="40" IsVisible="False"
                                Clicked="OnDeleteEntry" />

                        <Label Text="🔒 这一篇只存在这台设备上，不上传，也不会出现在家长面板里。"
                               FontSize="11" TextColor="#A79BC0" HorizontalTextAlignment="Center"
                               Margin="0,2,0,0" />

                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

        </Grid>
    </Grid>
</ContentPage>
