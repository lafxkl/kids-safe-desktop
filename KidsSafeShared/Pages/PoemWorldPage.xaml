<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:KidsSafeDesktop.Models"
             xmlns:services="clr-namespace:KidsSafeDesktop.Services"
             x:Class="KidsSafeDesktop.Pages.PoemWorldPage"
             Title="古诗学习"
             Background="{StaticResource KidPageGradient}">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- 主题背景大图 -->
        <Image Grid.Row="0" Grid.RowSpan="4"
               Source="{Binding Source={x:Static services:ThemeService.Instance}, Path=CurrentTheme.BackgroundFile}"
               Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" />

        <!-- 顶部栏 -->
        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,12" Background="{StaticResource KidHeaderGradient}">
            <Button Text="← 返回" TextColor="White" BackgroundColor="Transparent" BorderWidth="0"
                    FontSize="16" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Grid.Column="1" Text="📜 古诗学习" TextColor="White" FontSize="20" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="2" x:Name="TotalLabel" Text="" TextColor="White" FontSize="14"
                   HorizontalOptions="End" VerticalOptions="Center" />
        </Grid>

        <!-- 引导语 -->
        <Label Grid.Row="1" Text="读一读、听一听，把喜欢的诗记在心里～"
               FontSize="15" TextColor="#5D4037" HorizontalOptions="Center"
               Margin="20,10,20,4" HorizontalTextAlignment="Center" />

        <!-- 分类筛选：横向滚动，选中项高亮 -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                    Margin="16,4,16,8">
            <HorizontalStackLayout x:Name="ChipBar" Spacing="9" />
        </ScrollView>

        <!-- 诗词列表 -->
        <CollectionView Grid.Row="3" x:Name="PoemList" Margin="16,4,16,24"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Poem">
                    <Frame CornerRadius="20" Padding="16" HasShadow="False"
                           BackgroundColor="#FFFFFF" BorderColor="Transparent">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPoemTapped" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <!-- 分类色块 -->
                            <Frame Grid.Column="0" WidthRequest="52" HeightRequest="52" CornerRadius="26"
                                   Padding="0" HasShadow="False" VerticalOptions="Center"
                                   BackgroundColor="{Binding Accent}">
                                <Label Text="{Binding Emoji}"
                                       FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>

                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding Title}" FontSize="19" FontAttributes="Bold"
                                       TextColor="#3E2723" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding AuthorLine}" FontSize="13" TextColor="#8D6E63" />
                                <Label Text="{Binding Preview}" FontSize="13.5" TextColor="#A1887F"
                                       LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>

                            <Label Grid.Column="2" Text="›" FontSize="26" TextColor="#D7CCC8"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
