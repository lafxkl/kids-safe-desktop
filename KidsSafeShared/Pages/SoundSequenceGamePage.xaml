<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KidsSafeDesktop.Pages.SoundSequenceGamePage"
             Title="听音复述"
             Background="{StaticResource KidPageGradient}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,12" Background="{StaticResource KidHeaderGradient}">
            <Button Text="← 返回" TextColor="White" BackgroundColor="Transparent" BorderWidth="0"
                    FontSize="16" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Grid.Column="1" Text="🎵 听音复述" TextColor="White" FontSize="19"
                   FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="2" x:Name="ProgressLabel" Text="第 1 / 5 关" TextColor="White"
                   FontSize="15" VerticalOptions="Center" HorizontalOptions="End" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="6" Padding="20,14,20,4">
            <Label x:Name="PromptLabel" Text="🎵 请听，记住声音的顺序" FontSize="20"
                   FontAttributes="Bold" TextColor="#283593" HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
            <Label x:Name="FeedbackLabel" Text="共 3 个音，听完请按顺序点出来" FontSize="14"
                   TextColor="#5C6BC0" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- 三个超大音符按钮：颜色 + 文字 + 位置三重编码，低视力也点得中 -->
        <VerticalStackLayout Grid.Row="2" Spacing="12" Padding="20,8,20,8" VerticalOptions="Center">
            <Button x:Name="BtnC" Text="哆  Do" FontSize="26" FontAttributes="Bold"
                    BackgroundColor="#EF5350" TextColor="White" CornerRadius="26"
                    HeightRequest="104" Clicked="OnNoteClicked"
                    CommandParameter="0"
                    SemanticProperties.Description="第一个音符，哆" />
            <Button x:Name="BtnE" Text="咪  Mi" FontSize="26" FontAttributes="Bold"
                    BackgroundColor="#FFB300" TextColor="White" CornerRadius="26"
                    HeightRequest="104" Clicked="OnNoteClicked"
                    CommandParameter="1"
                    SemanticProperties.Description="第二个音符，咪" />
            <Button x:Name="BtnG" Text="嗦  Sol" FontSize="26" FontAttributes="Bold"
                    BackgroundColor="#42A5F5" TextColor="White" CornerRadius="26"
                    HeightRequest="104" Clicked="OnNoteClicked"
                    CommandParameter="2"
                    SemanticProperties.Description="第三个音符，嗦" />
        </VerticalStackLayout>

        <Button Grid.Row="3" Text="🔁 再听一次" FontSize="18" FontAttributes="Bold"
                BackgroundColor="#5C6BC0" TextColor="White" CornerRadius="18"
                HeightRequest="54" Margin="24,4,24,16" Clicked="OnReplaySequence"
                SemanticProperties.Description="重新播放这一串音符" />

        <Grid Grid.Row="0" Grid.RowSpan="4" x:Name="ResultLayer" IsVisible="False"
              BackgroundColor="#F5FFFFFF">
            <ScrollView Padding="28,20">
                <VerticalStackLayout Spacing="16" VerticalOptions="Center">
                    <Label Text="🏆" FontSize="76" HorizontalOptions="Center" />
                    <Label x:Name="ResultTitle" Text="训练完成！" FontSize="26" FontAttributes="Bold"
                           TextColor="#283593" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <Label x:Name="ResultDetail" Text="" FontSize="17" TextColor="#3949AB"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    <Label x:Name="ResultTip" Text="" FontSize="14" TextColor="#6D4C41"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    <Button Text="🔄 再练一次" FontSize="19" BackgroundColor="#3949AB" TextColor="White"
                            CornerRadius="18" HeightRequest="58" Margin="0,8,0,0" Clicked="OnReplayAll" />
                    <Button Text="↩️ 回到板块" FontSize="17" BackgroundColor="#FFFFFF" TextColor="#3949AB"
                            CornerRadius="18" HeightRequest="54" Clicked="OnBack" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
