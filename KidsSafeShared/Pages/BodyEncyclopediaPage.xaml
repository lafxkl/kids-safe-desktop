<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:KidsSafeDesktop.Models"
             x:Class="KidsSafeDesktop.Pages.BodyEncyclopediaPage"
             Title="身体百科"
             Background="{StaticResource KidPageGradient}">

    <Grid RowDefinitions="Auto,*">
        <!-- 顶部栏 -->
        <Grid ColumnDefinitions="Auto,*" Padding="16,12" BackgroundColor="#EF6C00">
            <Button Text="← 返回" TextColor="White" BackgroundColor="Transparent" BorderWidth="0"
                    FontSize="16" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Grid.Column="1" Text="🧍 身体百科" TextColor="White" FontSize="20" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1" Padding="20,14,20,40">
            <VerticalStackLayout Spacing="14">
                <!-- 分类筛选 -->
                <Label Text="选择部位分类" FontSize="15" TextColor="#E65100" FontAttributes="Bold" />
                <HorizontalStackLayout x:Name="CategoryStack" Spacing="8" />

                <!-- 部位列表 -->
                <CollectionView x:Name="PartsView" ItemsSource="{Binding Parts}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:BodyPart">
                            <Frame BackgroundColor="#FFFFFF" CornerRadius="20" Padding="10" HasShadow="False"
                                   BorderColor="#FFCC80">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPartTapped" />
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="{Binding Emoji}" FontSize="48" HorizontalOptions="Center" />
                                    <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold"
                                           TextColor="#E65100" HorizontalOptions="Center" />
                                    <Label Text="{Binding Category}" FontSize="13" TextColor="#8D6E63"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- 详情 -->
                <Frame BackgroundColor="#FFF3E0" CornerRadius="22" Padding="20,22" HasShadow="False"
                       BorderColor="Transparent" IsVisible="{Binding SelectedPart, Converter={StaticResource HasItem}}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label Text="{Binding SelectedPart.Emoji}" FontSize="64" VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding SelectedPart.Name}" FontSize="28" FontAttributes="Bold"
                                       TextColor="#E65100" />
                                <Label Text="{Binding SelectedPart.Category}" FontSize="15" TextColor="#8D6E63" />
                            </VerticalStackLayout>
                            <Button Text="🔊" FontSize="22" BackgroundColor="#FFB300" TextColor="White"
                                    CornerRadius="24" HeightRequest="48" WidthRequest="56"
                                    HorizontalOptions="EndAndExpand" Clicked="OnSpeak" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding SelectedPart.Description}" FontSize="18" TextColor="#5D4037"
                               HorizontalTextAlignment="Center" />
                        <Frame BackgroundColor="#FFFFFF" CornerRadius="14" Padding="12,10" HasShadow="False"
                               BorderColor="#FFCC80">
                            <Label Text="{Binding SelectedPart.FunFact, StringFormat='🌟 {0}'}" FontSize="15"
                                   TextColor="#EF6C00" />
                        </Frame>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
