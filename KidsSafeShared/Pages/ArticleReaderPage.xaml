<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KidsSafeDesktop.Pages.ArticleReaderPage"
             Title="亲子阅"
             Padding="0">

    <Grid RowDefinitions="Auto,*">

        <!-- 顶部栏 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="10,12" BackgroundColor="#2E7D32">
            <Button Text="← 返回" TextColor="White" BackgroundColor="Transparent" BorderWidth="0"
                    FontSize="16" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Grid.Column="1" Text="📖 亲子阅" TextColor="White" FontSize="18" FontAttributes="Bold"
                   VerticalOptions="Center" HorizontalOptions="Center" />
            <Button x:Name="ReadButton" Grid.Column="2" Text="🔊 读给小朋友" FontSize="13" TextColor="White"
                    BackgroundColor="#1B5E20" CornerRadius="14" HeightRequest="38" Clicked="OnReadToggle" />
        </Grid>

        <!-- 正文 -->
        <ScrollView Grid.Row="1" Padding="20,16">
            <VerticalStackLayout Spacing="14">
                <Frame WidthRequest="120" HeightRequest="120" CornerRadius="60" Padding="0"
                       HasShadow="False" HorizontalOptions="Center" x:Name="HeaderFrame">
                    <Label x:Name="PosterLabel" Text="📖" FontSize="64"
                           HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" />
                </Frame>
                <Label x:Name="TitleLabel" Text="" FontSize="24" FontAttributes="Bold"
                       TextColor="#1B5E20" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Label x:Name="DescLabel" Text="" FontSize="15" TextColor="#2E7D32"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />

                <FlexLayout x:Name="TagLayout" Wrap="Wrap" JustifyContent="Center" HorizontalOptions="Center" />

                <BoxView HeightRequest="1" BackgroundColor="#C8E6C9" Margin="0,6" />

                <StackLayout x:Name="BodyList" Spacing="12" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
