<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KidsSafeDesktop.ViewModels"
             x:Class="KidsSafeDesktop.Pages.LinkMatchGamePage"
             Title="连连看"
             Background="{StaticResource KidPageGradient}">

    <ContentPage.Resources>
        <Style x:Key="LinkTileStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="Stroke" Value="#FFD180" />
            <Setter Property="StrokeThickness" Value="3" />
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding Selected}" Value="True">
                    <Setter Property="BackgroundColor" Value="#FFF59D" />
                    <Setter Property="Stroke" Value="#FB8C00" />
                    <Setter Property="StrokeThickness" Value="5" />
                </DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding Hint}" Value="True">
                    <Setter Property="Stroke" Value="#66BB6A" />
                    <Setter Property="StrokeThickness" Value="5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- 顶部栏 -->
        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,12" Background="{StaticResource KidHeaderGradient}">
            <Button Text="← 返回" TextColor="White" BackgroundColor="Transparent" BorderWidth="0"
                    FontSize="16" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Grid.Column="1" Text="🔗 连连看" TextColor="White" FontSize="20" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="2" Text="{Binding ProgressText}" TextColor="White" FontSize="16"
                   HorizontalOptions="End" VerticalOptions="Center" />
        </Grid>

        <!-- 游戏区：上=难度 / 中=棋盘（吃掉剩余空间并居中） / 下=按钮。
             这里不用 ScrollView —— 棋盘要按「可用空间」反算格子大小，
             放进可滚动容器后高度是无限的，反算会失效（这正是原来右侧被裁掉的原因）。 -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Padding="12,8,12,16"
              IsVisible="{Binding NotFinished}">

            <Label Grid.Row="0" Text="{Binding DifficultyLabel, StringFormat='难度：{0}'}" FontSize="15"
                   TextColor="#0097A7" HorizontalOptions="Center" Margin="0,0,0,4" />

            <!-- BoardHost 只负责报告可用尺寸，Board 在它内部居中 -->
            <Grid Grid.Row="1" x:Name="BoardHost"
                  HorizontalOptions="Fill" VerticalOptions="Fill"
                  SizeChanged="OnBoardHostSizeChanged">
                <Grid x:Name="Board" HorizontalOptions="Center" VerticalOptions="Center">
                    <Grid x:Name="TileGrid" />
                    <GraphicsView x:Name="LinkCanvas" InputTransparent="True"
                                  HorizontalOptions="Fill" VerticalOptions="Fill" />
                </Grid>
            </Grid>

            <HorizontalStackLayout Grid.Row="2" Spacing="14" HorizontalOptions="Center" Margin="0,10,0,0">
                <Button Text="💡 提示" FontSize="18" BackgroundColor="#FFB300" TextColor="White"
                        CornerRadius="16" HeightRequest="50" WidthRequest="140" Clicked="OnHint" />
                <Button Text="🔀 洗牌" FontSize="18" BackgroundColor="#26C6DA" TextColor="White"
                        CornerRadius="16" HeightRequest="50" WidthRequest="140" Clicked="OnShuffle" />
            </HorizontalStackLayout>
        </Grid>

        <!-- 完成区 -->
        <ScrollView Grid.Row="1" IsVisible="{Binding Finished}" Padding="40,30">
            <VerticalStackLayout Spacing="24" VerticalOptions="Center">
                <Label Text="🏆" FontSize="100" HorizontalOptions="Center" />
                <Label Text="你真棒！" FontSize="38" FontAttributes="Bold" TextColor="#00838F"
                       HorizontalOptions="Center" />
                <Label Text="{Binding ResultText}" FontSize="22" TextColor="#0097A7"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Button Text="🔄 再玩一次" FontSize="22" BackgroundColor="#0097A7" TextColor="White"
                        CornerRadius="18" HeightRequest="60" WidthRequest="240" HorizontalOptions="Center"
                        Clicked="OnReplay" />
                <Button Text="🏠 回主页" FontSize="20" BackgroundColor="#FFFFFF" TextColor="#0097A7"
                        CornerRadius="18" HeightRequest="56" WidthRequest="240" HorizontalOptions="Center"
                        Clicked="OnBack" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
